table InterfaceHealth
	lineageTag: 6ccce8be-a15e-407b-9f3a-b90fb90bd1ba

	measure 'Message Attempts' = SUM ( InterfaceHealth[attempts] )
		formatString: #,0
		lineageTag: 1ad5ab37-67b5-4723-9ea5-e391f749539d

	measure 'Interface Errors' = SUM ( InterfaceHealth[errors] )
		formatString: #,0
		lineageTag: 87d7c1c0-f590-41d1-8088-b2f6c3d6ba9e

	measure 'Interface Success Rate' = DIVIDE ( SUM ( InterfaceHealth[processed] ), SUM ( InterfaceHealth[attempts] ) )
		formatString: 0.0%
		lineageTag: 6fc19eab-bcc3-43c8-827b-fe0ec115afc5

	measure 'Processed Msgs' = SUM ( InterfaceHealth[processed] )
		formatString: #,0

	measure 'Pending Msgs' = SUM ( InterfaceHealth[pending] )
		formatString: #,0

	column week_start
		dataType: dateTime
		formatString: Long Date
		lineageTag: a89112f0-b99f-4f1a-b043-6b5ce780bb5c
		summarizeBy: none
		sourceColumn: week_start

		variation Variation
			isDefault
			relationship: d2c9509f-75d0-4273-9e9b-9ac40b0866ae
			defaultHierarchy: LocalDateTable_cd6ec581-1886-4a4b-bda4-f0dd21c9e976.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column direction
		dataType: string
		lineageTag: 30358d3d-0ade-48ab-9fc0-b68d67dc8d27
		summarizeBy: none
		sourceColumn: direction

		annotation SummarizationSetBy = Automatic

	column msg_type
		dataType: string
		lineageTag: 73500f84-83a9-485e-a8b6-21fcd2b0c735
		summarizeBy: none
		sourceColumn: msg_type

		annotation SummarizationSetBy = Automatic

	column attempts
		dataType: int64
		formatString: 0
		lineageTag: fb620994-75e4-42f5-b646-a3f5c93b4365
		summarizeBy: sum
		sourceColumn: attempts

		annotation SummarizationSetBy = Automatic

	column processed
		dataType: int64
		formatString: 0
		lineageTag: 2d10cbaa-79b5-4fd0-8868-7e82747db5c3
		summarizeBy: sum
		sourceColumn: processed

		annotation SummarizationSetBy = Automatic

	column errors
		dataType: int64
		formatString: 0
		lineageTag: 952cd3fe-f1f7-4477-83a1-433b7989e620
		summarizeBy: sum
		sourceColumn: errors

		annotation SummarizationSetBy = Automatic

	column pending
		dataType: int64
		formatString: 0
		lineageTag: f2002212-3368-4f6b-8da1-1280432db91f
		summarizeBy: sum
		sourceColumn: pending

		annotation SummarizationSetBy = Automatic

	column success_rate
		dataType: double
		lineageTag: 27b6e2ae-54e8-4fb3-abe1-9f1ce8eb7533
		summarizeBy: sum
		sourceColumn: success_rate

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition InterfaceHealth = m
		mode: import
		source =
				let
				    Source = let Source = Csv.Document(File.Contents("C:\GitHub\SAP-MES-Integration-Validation-\exports\interface_health_weekly.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Typed = Table.TransformColumnTypes(Promoted, {{"week_start", type date}, {"direction", type text}, {"msg_type", type text}, {"attempts", Int64.Type}, {"processed", Int64.Type}, {"errors", Int64.Type}, {"pending", Int64.Type}, {"success_rate", type number}}, "en-US") in Typed
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

